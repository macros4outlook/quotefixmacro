Windows Registry Editor Version 5.00

; Template inside the code (USE_QUOTING_TEMPLATE) with the signature from Outlook below it (KEEP_SIGNATURE).
; The template has the greeting and the quote; the signature stays as maintained in Outlook.
; A colored reply (USE_COLORIZER) to an HTML mail keeps the signature as HTML, with its pictures, see
; https://macros4outlook.github.io/quotefixmacro/advanced-features.html#keep-the-outlook-signature
[HKEY_CURRENT_USER\Software\VB and VBA Program Settings\QuoteFixMacro\Config]
"USE_QUOTING_TEMPLATE"="True"
"KEEP_SIGNATURE"="True"

; The templates, as in QuoteFixMacro.bas (DEFAULT_QUOTING_TEMPLATE, DEFAULT_QUOTING_TEMPLATE_EN); change them here instead of in the code.
; \n is a new line (written as \\n in this file, as \n in regedit). QUOTING_TEMPLATE_EN is used for mails detected as English, see
; https://macros4outlook.github.io/quotefixmacro/setup-templates.html
; The file is saved in the Windows code page (not UTF-8), so that regedit reads the umlauts correctly.
"QUOTING_TEMPLATE"="Hallo %FN,\\n\\n(Antwort inline)\\n\\n%Q\\n\\nMit freundlichen Grüßen\\n\\n%MN\\n\\n(Antwort inline - powered by https://macros4outlook.github.io/quotefixmacro/)"
"QUOTING_TEMPLATE_EN"="Dear %FN,\\n\\n(reply inline)\\n\\n%Q\\n\\nCheers,\\n\\n%MFN\\n\\n(Reply inline - powered by https://macros4outlook.github.io/quotefixmacro/)"
